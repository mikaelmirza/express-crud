# Used by `npm test` — points at a separate database so tests never touch dev data
DATABASE_URL=postgres://postgres:postgres@localhost:5432/express_crud_test

# Fixed secret for tests only; never use it anywhere real
JWT_SECRET=test-only-secret-do-not-use-in-production-0123456789

# Cheap password hashing so the suite stays fast (production default is 2^17)
SCRYPT_N=1024

# Keep test output clean; logging tests create their own logger
LOG_LEVEL=silent

# Tests register many users from one IP; rate-limit tests build apps with their own limits
RATE_LIMIT_ENABLED=false
