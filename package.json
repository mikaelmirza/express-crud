{
  "name": "express-crud",
  "version": "1.0.0",
  "description": "Minimal modular Express CRUD skeleton",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import ./src/instrumentation.js src/server.js",
    "dev": "node --env-file-if-exists=.env --import ./src/instrumentation.js --watch src/server.js | pino-pretty",
    "test": "node --env-file=.env.test --import ./test/support/instrumentation.js --test --test-concurrency=1 'test/**/*.test.js'",
    "test:watch": "node --env-file=.env.test --import ./test/support/instrumentation.js --test --test-concurrency=1 --watch 'test/**/*.test.js'",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "pretest": "node --env-file=.env.test scripts/migrate.js",
    "pretest:watch": "node --env-file=.env.test scripts/migrate.js",
    "user:create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "start:no-telemetry": "node --env-file-if-exists=.env src/server.js",
    "up": "docker compose up -d --wait",
    "down": "docker compose --profile app down",
    "start:zero-code": "node --env-file-if-exists=.env --env-file=.env.zero-code --disable-warning=ExperimentalWarning --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import @opentelemetry/auto-instrumentations-node/register src/server.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "load": "node scripts/load.js",
    "app:up": "docker compose --profile app up -d --build --wait",
    "app:logs": "docker compose logs -f app",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/host-metrics": "^0.40.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-logs": "^3.1.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.9"
  }
}
