# Copy to .env for local development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/express_crud

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Optional
# JWT_EXPIRES_IN=15m

# Logging (optional)
# LOG_LEVEL=info        # trace | debug | info | warn | error | fatal | silent
# `npm run dev` pipes logs through pino-pretty for readable output (settings in .pino-prettyrc)

# Telemetry (optional). Standard OpenTelemetry variables; defaults suit `npm run up`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true          # turn traces, metrics and log export off
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1     # keep 10% of traces
# OTEL_METRIC_EXPORT_INTERVAL=10000  # ms between metric exports

# Browser access (optional). Comma-separated origins allowed to call the API
# from a browser; empty means none. Non-browser clients aren't affected.
# CORS_ORIGINS=http://localhost:5173

# Behind a load balancer or proxy, so rate limits see the client's real IP:
# false (default), true, a number of proxy hops, or proxy addresses
# TRUST_PROXY=1

# Rate limits (optional), per window. All load-test traffic comes from one IP,
# so set RATE_LIMIT_ENABLED=false when running `npm run load` against the app.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300                # all /api requests, per IP
# RATE_LIMIT_AUTH_MAX=10            # logins + sign-ups, per IP
# RATE_LIMIT_SHORT_SEARCH_MAX=20    # 1-2 character searches, per user

# Database timeouts and pool (optional)
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000        # give up waiting for a connection
# DB_STATEMENT_TIMEOUT_MS=10000     # Postgres cancels slower statements (0 = no limit)

# Shutdown (optional)
# SHUTDOWN_DELAY_MS=0               # keep serving with readiness failing, so a load balancer drains
# SHUTDOWN_TIMEOUT_MS=10000         # then wait this long for in-flight requests
