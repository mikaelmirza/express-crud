    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Process CPU as a share of the machine, against the machine overall. When logins push this to 100%, every request slows down, even ones that don't use the CPU much.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(process_cpu_utilization{service_name=\"$service\"})",
          "legendFormat": "this process",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(system_cpu_utilization{service_name=\"$service\", system_cpu_state=~\"user|system\"}) / count(system_cpu_utilization{service_name=\"$service\", system_cpu_state=\"user\"})",
          "legendFormat": "whole machine",
          "range": true
