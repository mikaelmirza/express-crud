    {
      "type": "timeseries",
      "title": "Event loop",
      "description": "Utilization is how busy the main thread is. Delay is how late timers fire. High delay with low utilization means the thread is waiting for CPU, not busy. (The ~10ms floor is the sampling resolution.)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nodejs_eventloop_utilization_ratio{service_name=\"$service\"}",
          "legendFormat": "utilization",
          "range": true
