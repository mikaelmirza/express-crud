    {
      "type": "timeseries",
      "title": "Password hashing",
      "description": "Time to hash or verify, including waiting for one of libuv's 4 threads. Normal is ~0.3s; seconds means logins are queueing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(app_auth_password_hash_duration_seconds_bucket{service_name=\"$service\", app_auth_operation=\"verify\"}[$__rate_interval])))",
          "legendFormat": "verify p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_auth_password_hash_duration_seconds_bucket{service_name=\"$service\", app_auth_operation=\"verify\"}[$__rate_interval])))",
