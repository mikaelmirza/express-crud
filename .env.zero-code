# Used by `npm run start:zero-code`, loaded after .env so these values win.
# This is the "ops" setup: OpenTelemetry attached at launch with environment
# variables only, using the stock zero-code package instead of src/instrumentation.js.

# A separate service name, so both modes can be compared side by side in Grafana
OTEL_SERVICE_NAME=express-crud-zero-code

# The zero-code package enables ~40 libraries by default (fs, dns, net...).
# Limit it to the ones the coded setup uses, for a like-for-like comparison.
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express,pg,pino,runtime-node

# Metrics over OTLP, every 10 seconds like the coded setup (the default is 60)
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000

# Switches off this app's custom spans, attributes and metrics (src/telemetry/),
# so the comparison shows automatic instrumentation on its own. In a real
# zero-code deployment there would simply be no custom code.
APP_CUSTOM_TELEMETRY=false

# The default detectors include cloud-provider metadata lookups (GCP, AWS...),
# which time out with warnings when not running in that cloud
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance
